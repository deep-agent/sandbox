# ==============================================================================
# Sandbox Docker Compose 配置示例
# 复制为 .env 后按需修改;未设置的变量会使用 docker-compose.yaml 中的默认值
# ==============================================================================

# ---- 对外端口 ----
# 宿主机端口 -> 容器 8080
HOST_PORT=8080

# ---- 容器内路径(Go 程序读取,请勿改成宿主机路径) ----
# Supervisor 配置目录(容器内)
SUPERVISOR_CONF_DIR=/home/sandbox/app.supervisor.d
# 容器时区
TZ=Asia/Shanghai

# ---- 宿主机挂载路径(docker-compose volume 左侧) ----
# 基础挂载目录,下辖 workspaces / agent / bin 三个子目录
LOCAL_MEMORY=./docker/volumes
LOCAL_SUPERVISOR_CONF=./docker/volumes/app.supervisor.d
LOCAL_USERDATA=./docker/volumes/userdata
LOCAL_INIT_SCRIPTS=./docker/volumes/init.d

# ---- 子服务开关 ----
ENABLE_MCP=true
ENABLE_BROWSER=true
ENABLE_VNC=true

# ---- 用户 app 服务端口(nginx 反代) ----
APP_SERVICE_PORT=9000

# ---- JWT 鉴权(默认关闭) ----
# 开启方法:填入 JWT_SECRET,并可选设置 JWT_AUTH_REQUIRED=true
#   JWT_SECRET          HMAC 共享密钥(HS256/384/512)
#   JWT_AUTH_REQUIRED   设为 true 时,若 JWT_SECRET 为空则拒绝所有请求
JWT_SECRET=
JWT_AUTH_REQUIRED=
