# ==============================================================================
# examples/web demo 专用配置
# 仅 `examples/web/web.go` 使用,不影响 sandbox 主程序部署
# 复制为 .env 后填入真实值(.env 已被 gitignore)
# ==============================================================================

# 火山方舟(Ark)模型 API Key
ARK_API_KEY=

# 火山方舟模型标识,例如 doubao-1-5-pro-32k-250115
ARK_MODEL=

# MCP 服务端点 URL,例如 http://localhost:8001/sse
MCP_URL=
